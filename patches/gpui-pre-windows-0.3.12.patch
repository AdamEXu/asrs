+#[cfg(test)]
+mod tests {
+    use super::*;
+    use windows::Win32::Foundation::HMODULE;
+
+    fn create_devices() -> Option<DirectXRendererDevices> {
+        let dxgi_factory: IDXGIFactory6 =
+            unsafe { CreateDXGIFactory2(DXGI_CREATE_FACTORY_FLAGS(0)) }.ok()?;
+        let adapter: IDXGIAdapter1 = unsafe { dxgi_factory.EnumWarpAdapter() }.ok()?;
+        let mut device = None;
+        let mut device_context = None;
+        unsafe {
+            D3D11CreateDevice(
+                None,
+                D3D_DRIVER_TYPE_WARP,
+                HMODULE::default(),
+                D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+                None,
+                D3D11_SDK_VERSION,
+                Some(&mut device),
+                None,
+                Some(&mut device_context),
+            )
+        }
+        .ok()?;
+        let devices = DirectXDevices {
+            adapter,
+            dxgi_factory,
+            device: device?,
+            device_context: device_context?,
+        };
+        DirectXRendererDevices::new(&devices, false).ok()
+    }
+
+    fn describe(texture: &ID3D11Texture2D) -> (u32, u32, u32) {
+        let mut desc = D3D11_TEXTURE2D_DESC::default();
+        unsafe { texture.GetDesc(&mut desc) };
+        (desc.Width, desc.Height, desc.SampleDesc.Count)
+    }
+
+    #[test]
+    fn test_path_textures_are_created_on_demand_at_the_current_size() {
+        let Some(devices) = create_devices() else {
+            return;
+        };
+        let mut resources =
+            DirectXResources::new(&devices, 64, 32, HWND::default(), false).expect("resources");
+        assert!(resources.path_textures.is_none());
+
+        for (width, height) in [(64, 32), (200, 100)] {
+            if width != 64 {
+                resources.render_target.take();
+                resources.render_target_view.take();
+                unsafe {
+                    devices.device_context.ClearState();
+                    devices.device_context.Flush();
+                    resources.swap_chain.ResizeBuffers(
+                        BUFFER_COUNT as u32,
+                        width,
+                        height,
+                        RENDER_TARGET_FORMAT,
+                        DXGI_SWAP_CHAIN_FLAG(0),
+                    )
+                }
+                .expect("resized buffers");
+                resources
+                    .recreate_resources(&devices, width, height)
+                    .expect("recreated resources");
+                assert!(resources.path_textures.is_none());
+            }
+            resources
+                .create_path_textures(&devices)
+                .expect("path textures");
+            let textures = resources.path_textures.as_ref().expect("path textures");
+            let intermediate = textures.path_intermediate_texture.clone();
+            assert_eq!(describe(&intermediate), (width, height, 1));
+            assert_eq!(
+                describe(&textures.path_intermediate_msaa_texture),
+                (width, height, PATH_MULTISAMPLE_COUNT),
+            );
+            assert!(textures.path_intermediate_srv.is_some());
+            assert!(textures.path_intermediate_msaa_view.is_some());
+
+            resources
+                .create_path_textures(&devices)
+                .expect("path textures");
+            let textures = resources.path_textures.as_ref().expect("path textures");
+            assert_eq!(textures.path_intermediate_texture, intermediate);
+        }
     }
