{
  "entry": "dom",
  "backend": "jsdom",
  "inputs": [
    "../logs/timeline-modes.json"
  ],
  "fixture": {
    "seed": 7,
    "ignoreMain": [
      "save-state",
      "save-type-memory",
      "update-touch-bar-slider",
      "show"
    ],
    "steps": [
      {
        "log": "../logs/timeline-modes.json"
      },
      {
        "main": "new-tab",
        "data": 10
      },
      {
        "frames": 2
      },
      {
        "selection": [
          "setSelectedTime",
          9
        ]
      },
      {
        "selection": [
          "play"
        ]
      },
      {
        "frames": 3
      },
      {
        "capture": [
          "selection",
          {
            "kind": "canvas",
            "selector": ".timeline-canvas"
          }
        ],
        "label": "playing"
      },
      {
        "advance": 2500
      },
      {
        "capture": [
          "selection",
          {
            "kind": "canvas",
            "selector": ".timeline-canvas"
          }
        ],
        "label": "playing-later"
      },
      {
        "selection": [
          "setPlaybackSpeed",
          4
        ]
      },
      {
        "advance": 3000
      },
      {
        "capture": [
          "selection",
          {
            "kind": "canvas",
            "selector": ".timeline-canvas"
          }
        ],
        "label": "playing-fast"
      },
      {
        "selection": [
          "pause"
        ]
      },
      {
        "frames": 1
      },
      {
        "capture": [
          "selection",
          {
            "kind": "canvas",
            "selector": ".timeline-canvas"
          }
        ],
        "label": "paused"
      }
    ]
  }
}
