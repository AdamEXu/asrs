        "eval": "window.tabs.tabList[1].controller.leftSourceList.setState([{\"type\": \"smooth\", \"logKey\": \"/Late\", \"logType\": \"Number\", \"visible\": true, \"options\": {\"size\": \"bold\", \"color\": \"#c0b487\"}}, {\"type\": \"stepped\", \"logKey\": \"/Nope\", \"logType\": \"String\", \"visible\": false, \"options\": {\"color\": \"#2b66a2\", \"size\": \"normal\"}}])"
      },
      {
        "advance": 50
      },
      {
        "capture": [
          "sourceLists",
          {
            "kind": "eval",
            "expr": "/*sl:widths*/ Array.from(document.querySelectorAll('div.source-list > div.list'), (list) => [list.parentElement.className, Array.from(list.children, (item) => [item.querySelector('div.type-name').innerText, item.querySelector('div.key-container').style.getPropertyValue('--type-width')])])"
          }
        ],
        "label": "set-state"
      }
    ]
  }
}
