{
  "entry": "hubSession",
  "inputs": [
    "logs/partial.wpilog"
  ],
  "fixture": {
    "seed": 4242,
    "steps": [
      {
        "main": "open-files",
        "data": {
          "files": [
            "logs/partial.wpilog"
          ],
          "merge": false
        }
      },
      {
        "capture": [
          {
            "kind": "eval",
            "expr": "document.getElementsByTagName('title')[0].textContent"
          },
          {
            "kind": "eval",
            "expr": "[document.documentElement.style.getPropertyValue('--show-loading-glow'), document.documentElement.style.getPropertyValue('--loading-glow-progress')]"
          },
          "selection",
          {
            "kind": "eval",
            "expr": "window.log.getFieldKeys()"
          },
          {
            "kind": "eval",
            "expr": "window.log.getTimestampRange()"
          },
          {
            "kind": "eval",
            "expr": "[...window.getLoadingFields()].sort()"
          }
        ],
        "label": "opening"
      },
      {
        "advance": 300
      },
      {
        "capture": [
          {
            "kind": "eval",
            "expr": "document.getElementsByTagName('title')[0].textContent"
          },
          {
            "kind": "eval",
            "expr": "[document.documentElement.style.getPropertyValue('--show-loading-glow'), document.documentElement.style.getPropertyValue('--loading-glow-progress')]"
          },
          "selection",
          {
            "kind": "eval",
            "expr": "window.log.getFieldKeys()"
          },
          {
            "kind": "eval",
            "expr": "window.log.getTimestampRange()"
          },
          {
            "kind": "eval",
            "expr": "[...window.getLoadingFields()].sort()"
          }
        ],
        "label": "opened"
      },
      {
        "main": "start-export"
      },
      {
        "main": "prepare-export",
        "data": {
          "path": "/out/partial.csv",
          "options": {
            "format": "csv-list",
            "samplingMode": "changes",
            "samplingPeriod": 20,
            "prefixes": "",
            "includeGenerated": true
          }
        }
      },
      {
        "capture": [
          {
            "kind": "eval",
            "expr": "[document.documentElement.style.getPropertyValue('--show-loading-glow'), document.documentElement.style.getPropertyValue('--loading-glow-progress')]"
          },
          {
            "kind": "eval",
            "expr": "[...window.getLoadingFields()].sort()"
          }
        ],
        "label": "exported"
      },
      {
        "main": "finish-export"
      },
      {
        "advance": 200
      },
      {
        "capture": [
          {
            "kind": "eval",
            "expr": "document.getElementsByTagName('title')[0].textContent"
          },
          {
            "kind": "eval",
            "expr": "[document.documentElement.style.getPropertyValue('--show-loading-glow'), document.documentElement.style.getPropertyValue('--loading-glow-progress')]"
          },
          "selection",
          {
            "kind": "eval",
            "expr": "window.log.getFieldKeys()"
          },
          {
            "kind": "eval",
            "expr": "window.log.getTimestampRange()"
          },
          {
            "kind": "eval",
            "expr": "[...window.getLoadingFields()].sort()"
          }
        ],
        "label": "finished"
      }
    ],
    "ignoreMain": [
      "save-state",
      "save-type-memory",
      "update-touch-bar-slider"
    ]
  }
}
