{
  "about": "Interaction: File > Export Layout, cancelled and then written, and File > Import Layout, cancelled; the dialogs and the JSON are compared. Two tabs, one with sources, so the file carries controller state",
  "actions": [
    {
      "open": [
        "app:drive"
      ]
    },
    {
      "idle": true
    },
    {
      "main": "restore-state",
      "data": {
        "sidebar": {
          "width": 300,
          "expanded": [
            "/Drive"
          ]
        },
        "tabs": {
          "selected": 1,
          "tabs": [
            {
              "type": 0,
              "title": "",
              "controller": null,
              "controllerUUID": "documentation0000000000000000000",
              "renderer": "",
              "controlsHeight": 0
            },
            {
              "type": 1,
              "title": "Graph",
              "controller": {
                "leftSources": [
                  {
                    "type": "stepped",
                    "logKey": "/Drive/LeftVelocity",
                    "logType": "Number",
                    "visible": true,
                    "options": {
                      "color": "#2b66a2",
                      "size": "normal"
                    }
                  }
                ],
                "rightSources": [
                  {
                    "type": "smooth",
                    "logKey": "/Drive/RightVelocity",
                    "logType": "Number",
                    "visible": true,
                    "options": {
                      "color": "#e5b31b",
                      "size": "bold"
                    }
                  }
                ],
                "discreteSources": [
                  {
                    "type": "stripes",
                    "logKey": "/Drive/Mode",
                    "logType": "String",
                    "visible": true,
                    "options": {
                      "color": "#80588e"
                    }
                  }
                ],
                "leftLockedRange": null,
                "rightLockedRange": null,
                "leftUnitConversion": {
                  "autoTarget": null,
                  "preset": null
                },
                "rightUnitConversion": {
                  "autoTarget": null,
                  "preset": null
                },
                "leftFilter": 0,
                "rightFilter": 0,
                "showRobotMode": false
              },
              "controllerUUID": "linegraph00000000000000000000000",
              "renderer": null,
              "controlsHeight": 200
            },
            {
              "type": 4,
              "title": "Table",
              "controller": [],
              "controllerUUID": "tabletable0000000000000000000000",
              "renderer": null,
              "controlsHeight": 0
            }
          ]
        }
      }
    },
    {
      "idle": true
    },
    {
      "dialog": null
    },
    {
      "appMenu": [
        "Export Layout..."
      ]
    },
    {
      "wait": 300
    },
    {
      "dialog": "layout.json"
    },
    {
      "appMenu": [
        "Export Layout..."
      ]
    },
    {
      "wait": 600
    },
    {
      "dialog": null
    },
    {
      "appMenu": [
        "Import Layout..."
      ]
    },
    {
      "wait": 300
    },
    {
      "mouse": "move",
      "x": 700,
      "y": 630
    },
    {
      "idle": true
    },
    {
      "capture": "exported",
      "probes": [
        ".side-bar",
        ".tab-bar",
        ".renderer-content",
        ".controls-content",
        ".timeline"
      ]
    }
  ]
}
