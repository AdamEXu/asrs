{
  "about": "Interaction: playback to the end of the log, which stops it: from 9.6 s with the play button, and again after a pause at the start of it. The selected time at the end, the canvas and the saved HubState are compared",
  "titleBar": true,
  "actions": [
    {
      "open": [
        "app:drive"
      ]
    },
    {
      "idle": true
    },
    {
      "main": "restore-state",
      "data": {
        "sidebar": {
          "width": 300,
          "expanded": [
            "/Drive"
          ]
        },
        "tabs": {
          "selected": 1,
          "tabs": [
            {
              "type": 0,
              "title": "",
              "controller": null,
              "controllerUUID": "documentation0000000000000000000",
              "renderer": "",
              "controlsHeight": 0
            },
            {
              "type": 1,
              "title": "Graph",
              "controller": {
                "leftSources": [
                  {
                    "type": "stepped",
                    "logKey": "/Drive/LeftVelocity",
                    "logType": "Number",
                    "visible": true,
                    "options": {
                      "color": "#2b66a2",
                      "size": "normal"
                    }
                  }
                ],
                "rightSources": [
                  {
                    "type": "smooth",
                    "logKey": "/Drive/RightVelocity",
                    "logType": "Number",
                    "visible": true,
                    "options": {
                      "color": "#e5b31b",
                      "size": "bold"
                    }
                  }
                ],
                "discreteSources": [
                  {
                    "type": "stripes",
                    "logKey": "/Drive/Mode",
                    "logType": "String",
                    "visible": true,
                    "options": {
                      "color": "#80588e"
                    }
                  }
                ],
                "leftLockedRange": null,
                "rightLockedRange": null,
                "leftUnitConversion": {
                  "autoTarget": null,
                  "preset": null
                },
                "rightUnitConversion": {
                  "autoTarget": null,
                  "preset": null
                },
                "leftFilter": 0,
                "rightFilter": 0,
                "showRobotMode": false
              },
              "controllerUUID": "linegraph00000000000000000000000",
              "renderer": null,
              "controlsHeight": 200
            }
          ]
        }
      }
    },
    {
      "idle": true
    },
    {
      "selection": [
        "setSelectedTime",
        9.6
      ]
    },
    {
      "mouse": "move",
      "x": 700,
      "y": 630
    },
    {
      "idle": true
    },
    {
      "capture": "ready",
      "probes": [
        ".side-bar",
        ".tab-bar",
        ".renderer-content",
        ".controls-content",
        ".timeline"
      ]
    },
    {
      "mouse": "move",
      "x": 970,
      "y": 22,
      "on": "button.play"
    },
    {
      "mouse": "click",
      "x": 970,
      "y": 22,
      "on": "button.play"
    },
    {
      "wait": 1500
    },
    {
      "mouse": "move",
      "x": 700,
      "y": 630
    },
    {
      "idle": true
    },
    {
      "capture": "ended",
      "probes": [
        ".side-bar",
        ".tab-bar",
        ".renderer-content",
        ".controls-content",
        ".timeline"
      ]
    },
    {
      "selection": [
        "setSelectedTime",
        9.9
      ]
    },
    {
      "wait": 200
    },
    {
      "key": "Space"
    },
    {
      "wait": 1200
    },
    {
      "idle": true
    },
    {
      "capture": "space",
      "probes": [
        ".side-bar",
        ".tab-bar",
        ".renderer-content",
        ".controls-content",
        ".timeline"
      ]
    }
  ]
}
