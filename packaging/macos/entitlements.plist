<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The match timer's OCR runs WebAssembly under wasmtime, which makes its code pages
         executable with mprotect and without MAP_JIT, so allow-jit does not cover it. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- A user's own build of asrs-libm-lgpl, which the LGPL lets them swap in, has no
         signature of the app's team. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
